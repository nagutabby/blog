{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "name": "sveltekit-blog-local",
  "main": "../web/src/worker/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SITE_BASE_URL": "https://blog.app.nagutabby.uk"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/healthz",
      "/.well-known/*",
      "/nodeinfo/*",
      "/actor*",
      "/api/articles/*",
      "/rpc/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": [
      "ACTOR_PUBLIC_KEY_PEM",
      "ACTOR_PRIVATE_KEY_PEM",
      "FEDERATION_ADMIN_TOKEN",
      "EMAIL_API_TOKEN",
      "FROM_ADDRESS",
      "BCC_ADDRESS"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sveltekit-blog-db",
      "database_id": "2b4db5b8-4d5a-43ee-b79d-3037f87cec89",
      "migrations_dir": "db/migrations"
    }
  ]
}
